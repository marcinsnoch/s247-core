# =========================================================================
# s247 Core API (FastAPI)
# =========================================================================
PROJECT_NAME="s247 Core API"
API_PREFIX=/v1
DEBUG=True

# Baza danych PostgreSQL (w sieci Docker host: s247_postgres, port: 5432)
DATABASE_URL=postgresql+asyncpg://db_admin:SuperBezpieczneHasloPostgres123!@s247_postgres:5432/s247_database

# Bezpieczeństwo JWT (użytkownicy)
SECRET_KEY=s247_super_secret_jwt_key_change_me_in_production_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# RabbitMQ (OAuth2 / Shovel)
RABBITMQ_URL=amqp://core_app:password123@s247_rabbitmq:5672/hub
RABBITMQ_JWT_KEY_PATH=/etc/rabbitmq/jwt_private_key.pem
RABBITMQ_TOKEN_EXPIRE_MINUTES=15

# Dozwolone originy CORS
CORS_ORIGINS=["*"]
